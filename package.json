{
  "name": "@dablulite/rn-audio-stream",
  "version": "1.0.0",
  "description": "React Native audio player with streaming, gapless playback, shuffle and repeat",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "audio",
    "player",
    "streaming",
    "gapless",
    "shuffle",
    "repeat",
    "navidrome",
    "subsonic",
    "radio"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    }
  },
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-sound-player": ">=0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.5.0",
    "react-native-sound-player": "^0.13.4",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "moduleNameMapper": {
      "^react-native-sound-player$": "<rootDir>/__mocks__/react-native-sound-player.ts"
    }
  }
}